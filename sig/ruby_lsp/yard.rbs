module RubyLsp
  module Yard
    VERSION: String

    class Error < StandardError
    end

    class Addon
      attr_reader settings: Settings?
      attr_reader indexer: Indexer::Adapter?
      attr_reader signature_store: SignatureStore?
      attr_reader inference: Inference::Engine?
      attr_reader log: Log?
      attr_reader rbs_loader: Rbs::Loader?
      attr_reader rbs_source: Rbs::Source?
      attr_reader gem_cache: Gems::Cache?

      def activate: (untyped global_state, untyped outgoing_queue) -> void
      def deactivate: () -> void
      def workspace_did_change_watched_files: (untyped changes) -> void
      def create_hover_listener: (untyped response_builder, untyped node_context, untyped dispatcher) -> void
      def create_completion_listener: (untyped response_builder, untyped node_context, untyped dispatcher, untyped uri) -> void
      def create_definition_listener: (untyped response_builder, untyped uri, untyped node_context, untyped dispatcher) -> void
      def name: () -> String
      def version: () -> String
    end

    class Settings
      FEATURES: untyped
      BOOLEAN_DEFAULTS: untyped
      LOG_LEVELS: Array[Symbol]
      def initialize: (untyped raw) -> void
      def enabled?: (Symbol feature) -> bool
      def log_level: () -> Symbol
      def debug_inference?: () -> bool
    end

    class Log
      def initialize: (untyped outgoing_queue, ?level: Symbol) -> void
      def debug: (untyped message) -> void
      def info: (untyped message) -> void
      def warn: (untyped message) -> void
      def error: (untyped message) -> void
    end

    class SignatureStore
      def initialize: (Indexer::Adapter adapter, ?log: Log?, ?rbs: Rbs::Source?, ?gem_cache: Gems::Cache?) -> void
      def lookup: (String? owner, (String | Symbol)? name, ?singleton: bool) -> Signature?
      def invalidate: (untyped uris) -> void
    end

    class Signature
      class Param
        attr_accessor name: Symbol?
        attr_accessor kind: Symbol?
        attr_accessor types: untyped
        attr_accessor description: String?
        def typed?: () -> bool
      end

      class Option
        attr_accessor name: String?
        attr_accessor key: String?
        attr_accessor types: untyped
        attr_accessor default: untyped
        attr_accessor description: String?
      end

      def initialize: (untyped kwargs) -> void
      def deprecated?: () -> bool
      def documented?: () -> bool
      def typed?: () -> bool
      def renderable?: () -> bool
      def signature_line: () -> String
      def parameter_list: () -> String
      def return_type_string: () -> String?
      def with_type_bindings: (Hash[Symbol, untyped] bindings) -> Signature
      def to_markdown: () -> String
    end

    module Documentation
      class TagExtractor
        def initialize: (?log: Log?) -> void
        def extract: (String? comments) -> RawDoc
      end
    end

    module Types
      UNKNOWN: untyped
      NIL_TYPE: untyped
      BOOLEAN: untyped
      SELF: untyped
      VOID: untyped
      UNTYPED: untyped

      class Parser
        def initialize: (?resolver: untyped, ?nesting: Array[String]) -> void
        def parse: (untyped type_string) -> untyped
        def parse!: (untyped type_string) -> untyped
        def parse_list: (Array[String] type_strings) -> untyped
      end

      class TypeVar
        attr_accessor name: Symbol
      end

      def self.substitute_type_vars: (untyped type, Hash[Symbol, untyped] mapping) -> untyped

      module Formatter
        def self.format: (untyped type) -> String
      end
    end

    module Rbs
      class Loader
        def initialize: (?log: Log?, ?background: bool) -> void
        def start: () -> void
        def cancel: () -> void
        def ready?: () -> bool
        def subscribe: () { () -> void } -> Proc
        def load: () -> void
      end

      class Converter
        def initialize: (?environment: untyped, ?builder: untyped) -> void
        def convert: (untyped type, ?depth: Integer) -> untyped
      end

      class Source
        def initialize: (Loader loader, ?log: Log?) -> void
        def ready?: () -> bool
        def subscribe: () { () -> void } -> Proc
        def lookup: (untyped owner, untyped name, ?singleton: bool) -> Signature?
      end
    end

    module Gems
      class Locator
        def initialize: (?specs: untyped, ?lockfile: String?) -> void
        def identity: (untyped uri_or_path) -> [String, String]?
        def lock_digest: () -> String?
      end

      class Cache
        SCHEMA_VERSION: Integer
        def initialize: (?root: String?, ?locator: Locator?, ?schema: Integer, ?log: Log?) -> void
        def identity: (untyped uri_or_path) -> [String, String]?
        def read: (untyped gem, untyped key) -> Signature?
        def write: (untyped gem, untyped key, Signature? signature) -> void
        def flush: () -> void
        def invalidate: () -> void
      end
    end

    module Inference
      class Budget
        class Exceeded < StandardError
        end

        def initialize: (?timeout_ms: Integer, ?max_depth: Integer, ?check_interval: Integer, ?clock: untyped) -> void
        def check!: (Integer depth) -> void
        def visit: (untyped key) -> bool
      end

      class Resolution
        class Member
          attr_reader owner: String
          attr_reader singleton: bool
          attr_reader label: String
          attr_reader type_args: Array[untyped]
        end

        attr_reader members: Array[Member]
        attr_reader duck_methods: Array[String]
        attr_reader source: Symbol

        def yard?: () -> bool
        def empty?: () -> bool
        def primary: () -> Member?
      end

      class ScopeIndex
        def initialize: (untyped node_context, ?log: Log?) -> void
        def available?: () -> bool
        def local_scope: untyped
        def class_scope: untyped
        def assignment_value_nodes: (String name, Integer before_offset) -> Array[untyped]
        def ivar_value_nodes: (String name) -> Array[untyped]
        def block_parameters: () -> Array[[String, Symbol]]
        def self.block_parameters_for: (untyped block) -> Array[[String, Symbol]]
      end

      class Engine
        def initialize: (adapter: Indexer::Adapter, store: SignatureStore, ?host: untyped, ?log: Log?, ?budget_ms: Integer, ?debug: bool) -> void
        def owner_for: (untyped node_context) -> [String, bool]?
        def signature_for: (untyped node_context) -> Signature?
        def resolution_for: (untyped node_context) -> Resolution?
        def type_for: (untyped node, untyped node_context, ?budget: Budget?) -> untyped
      end
    end

    module Listeners
      class Completion
        def initialize: (untyped response_builder, untyped node_context, untyped dispatcher, adapter: Indexer::Adapter, store: SignatureStore, inference: Inference::Engine, ?log: Log?) -> void
      end

      class Definition
        def initialize: (untyped response_builder, untyped node_context, untyped dispatcher, adapter: Indexer::Adapter, inference: Inference::Engine, ?log: Log?) -> void
      end
    end

    module Indexer
      Location: untyped
      Parameter: untyped
      Definition: untyped

      class Adapter
        def initialize: (?log: Log?) -> void
        def subscribe: () { (untyped) -> void } -> untyped
        def on_change: (untyped uris) -> void
        def completion_candidates: (String owner, ?prefix: String?, ?singleton: bool) -> Array[Definition]
      end
    end
  end
end
